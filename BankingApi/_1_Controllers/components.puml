@startuml
'https://plantuml.com/component-diagram

' Force vertical layout
top to bottom direction

' Style and spacing tweaks for clearer vertical layout
skinparam componentStyle rectangle
skinparam nodesep 20
skinparam ranksep 36
skinparam componentFontSize 12

package "Controllers" {
  [HTTP]
  [CustomerController]
}

package "Customers" {
  ' Only the main Customer component lives inside the package
  [Customer]
}

' Ports placed outside the package and explicitly listed after the Customer so they appear below it
circle "Inbound" as InboundPort <<port>> #LightBlue
circle "Outbound" as OutboundPort <<port>> #LightGreen

package "Infrastructure" {
  [CustomerService]
  [CustomerRepository]
}

database "MySql" {
  folder "This is my folder" {
    [Folder 3]
  }
  frame "Foo" {
    [Frame 4]
  }
}

' Connections — layout remains vertical
[HTTP] --> [CustomerController]
' Controller uses the inbound port (dependency/port) -> visually shows CustomerController -> InboundPort
[CustomerController] --> InboundPort
' Previously InboundPort --> [Customer] removed to show the controller uses the port
[CustomerController] --> [Customer]
[Customer] --> OutboundPort
[Customer] --> [CustomerService]
[CustomerService] --> [CustomerRepository]
[Customer] --> [Folder 3]
[Folder 3] --> [Frame 4]

@enduml